# REFERENCE ONLY — do not create apps/api/.env.
# The API loads the single root .env (see ../../.env.example) via
# `bun --env-file`; copy the root example to /.env instead.
# Values below mirror the root example for local dev (compose uses @db).
# Database
# Point at localhost when running the API outside compose (compose uses @db:5432).
DATABASE_URL=postgres://yuto:change-me-db-password@localhost:5432/yuto

# API
# Must be a random string of at least 32 characters.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Owner password. At least 12 characters.
YUTO_PASSWORD=change-me-to-a-password-of-at-least-12-chars
PORT=3000
NODE_ENV=production
# Keep true. Set false only for plain-HTTP LAN use behind trusted network.
COOKIE_SECURE=true
# Set false to disable the map picker (no tile loading in the browser).
MAP_ENABLED=true
