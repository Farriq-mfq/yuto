{
  "name": "yuto",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --parallel run dev:api dev:web",
    "dev:api": "bun --env-file=.env --watch apps/api/src/index.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "dev:native": "bun --parallel run dev:api dev:web",
    "native:url": "bun scripts/lan-url.ts",
    "cap:sync:dev": "cd apps/web && CAP_SERVER_URL=$(bun ../../scripts/lan-url.ts) bunx cap sync",
    "native:debug": "bun run cap:sync:dev && ./apps/web/android/gradlew --offline -p apps/web/android assembleDebug",
    "native:install": "adb install -r apps/web/android/app/build/outputs/apk/debug/app-debug.apk",
    "native:log": "adb logcat -v time | grep -iE \"yuto|capacitor|F/DEBUG|F/libc\"",
    "build": "bun run --cwd apps/web build",
    "build:web": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/api start",
    "start:api": "bun run --cwd apps/api start",
    "start:web": "bun run --cwd apps/web preview",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:seed": "bun run --cwd apps/api db:seed",
    "test": "bun test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "typescript": "^7.0.2"
  }
}
