# Copy to .env and fill in real secrets. Never commit .env.
# Database
POSTGRES_USER=yuto
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=yuto
# Point at the compose db service from inside the stack.
DATABASE_URL=postgres://yuto:change-me-db-password@db:5432/yuto

# API
# Must be a random string of at least 32 characters.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Owner password. At least 12 characters.
YUTO_PASSWORD=change-me-to-a-password-of-at-least-12-chars
PORT=3000
NODE_ENV=production
# Keep true. Set false only for plain-HTTP LAN use behind trusted network.
COOKIE_SECURE=true
# Set false to disable the map picker (no tile loading in the browser).
MAP_ENABLED=true
