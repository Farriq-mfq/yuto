{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CLAUDE.md",
    ".claude/rules/*.md"
  ],
  "agent": {
    "coding": {
      "description": "Implements features and bug fixes in the API (Elysia/Drizzle) or web (React).",
      "mode": "subagent",
      "prompt": "{file:./.claude/agents/coding.md}",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "bun *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git push*": "deny",
          "rm -rf*": "deny"
        }
      }
    },
    "testing": {
      "description": "Writes and runs tests (bun test, Playwright smoke); finds missing cases in money, balance, auth, and report logic.",
      "mode": "subagent",
      "prompt": "{file:./.claude/agents/testing.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "**/*.test.ts": "allow",
          "**/*.test.tsx": "allow",
          "e2e/**": "allow"
        },
        "bash": {
          "*": "ask",
          "bun test*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git push*": "deny",
          "rm -rf*": "deny"
        }
      }
    },
    "reviewer": {
      "description": "Reviews a diff or branch for correctness, security, data-loss risk, and scope creep. Read-only.",
      "mode": "subagent",
      "prompt": "{file:./.claude/agents/reviewer.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git push*": "deny",
          "rm -rf*": "deny"
        }
      }
    },
    "database": {
      "description": "Owns the Drizzle schema, migrations, indexes, seed data, and complex SQL.",
      "mode": "subagent",
      "prompt": "{file:./.claude/agents/database.md}",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "bunx drizzle-kit*": "allow",
          "bun *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git push*": "deny",
          "rm -rf*": "deny"
        }
      }
    },
    "devops": {
      "description": "Maintains Dockerfiles, docker-compose, env files, nginx config, and CI.",
      "mode": "subagent",
      "prompt": "{file:./.claude/agents/devops.md}",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "docker compose*": "allow",
          "docker compose down -v*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git push*": "deny",
          "rm -rf*": "deny"
        }
      }
    },
    "docs": {
      "description": "Keeps docs/ and CLAUDE.md accurate after code changes.",
      "mode": "subagent",
      "prompt": "{file:./.claude/agents/docs.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "**/*.md": "allow"
        },
        "bash": {
          "*": "deny"
        }
      }
    }
  }
}
